{
  "name": "dsh-llm-resilience",
  "version": "0.1.0",
  "private": true,
  "description": "为 DSH 的 LLM 请求提供可配置的空闲超时策略（默认 30 秒）与同路由重试策略：通过设置页管理 llm-pi-ai 提供商的超时与重试，绝不切换提供商或模型。",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "icon": "./icon.svg",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/policy.js",
    "lib/escalation.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "docs/IMPLEMENTATION.md",
    "scripts/smoke.mjs",
    "scripts/profile-state.mjs"
  ],
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "check": "node --check lib/index.js && node --check lib/policy.js && node --check lib/escalation.js && node --check lib/client.js && node --check scripts/smoke.mjs && node --check scripts/profile-state.mjs",
    "smoke": "node scripts/smoke.mjs",
    "smoke:profile": "node scripts/smoke.mjs --profile web"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.5"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "plugin",
    "llm",
    "timeout",
    "retry",
    "resilience"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  }
}
